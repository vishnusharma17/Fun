// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  name         String
  email        String    @unique
  avatar       String
  bio          String?
  styleTags    String    // Comma-separated strings, e.g. "Streetwear,Minimalist"
  instagram    String?
  createdAt    DateTime  @default(now())

  photos       Photo[]
  votes        Vote[]
  likes        Like[]
  comments     Comment[]
  createdBattles Battle[] @relation("BattleCreator")
}

model Photo {
  id           String    @id @default(uuid())
  title        String
  description  String?
  imageUrl     String
  category     String    // e.g. "Streetwear", "Formal", "Vintage", "High Fashion", "Minimalist"
  outfitTags   String?   // Comma-separated brand/item tags, e.g. "Nike, Acne Studios, Vintage Blazer"
  views        Int       @default(0)
  createdAt    DateTime  @default(now())

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  asPhotoA     Battle[]  @relation("PhotoA")
  asPhotoB     Battle[]  @relation("PhotoB")
  votes        Vote[]
  likes        Like[]
  comments     Comment[]
}

model Battle {
  id           String    @id @default(uuid())
  title        String?
  category     String?
  createdAt    DateTime  @default(now())

  photoAId     String
  photoA       Photo     @relation("PhotoA", fields: [photoAId], references: [id], onDelete: Cascade)

  photoBId     String
  photoB       Photo     @relation("PhotoB", fields: [photoBId], references: [id], onDelete: Cascade)

  creatorId    String?
  creator      User?     @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  votes        Vote[]
  likes        Like[]
  comments     Comment[]
}

model Vote {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  battleId     String
  battle       Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)

  selectedPhotoId String
  selectedPhoto Photo    @relation(fields: [selectedPhotoId], references: [id], onDelete: Cascade)

  @@unique([userId, battleId])
}

model Like {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoId      String?
  photo        Photo?    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  battleId     String?
  battle       Battle?   @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([userId, photoId, battleId])
}

model Comment {
  id           String    @id @default(uuid())
  content      String
  createdAt    DateTime  @default(now())

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoId      String?
  photo        Photo?    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  battleId     String?
  battle       Battle?   @relation(fields: [battleId], references: [id], onDelete: Cascade)
}
